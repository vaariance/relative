{
  "name": "eox",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @eox/evidence-store migrate",
    "test": "pnpm -r test",
    "cox:check": "pnpm cox:math:check && pnpm cox:client:check && pnpm cox:publisher:check",
    "cox:test": "pnpm cox:methodology:test && pnpm cox:math:test && pnpm cox:client:test && pnpm cox:publisher:test && pnpm cox:program:test",
    "cox:methodology:test": "pnpm --filter @cox/methodology test",
    "cox:math": "cargo run --manifest-path packages/cox/Cargo.toml --locked -p cox-cli --",
    "cox:math:check": "cargo fmt --manifest-path packages/cox/Cargo.toml --all --check && cargo clippy --manifest-path packages/cox/Cargo.toml --workspace --all-targets --locked -- -D warnings",
    "cox:math:test": "cargo test --manifest-path packages/cox/Cargo.toml --workspace --locked",
    "cox:client:check": "pnpm --filter @cox/client build",
    "cox:client:test": "pnpm --filter @cox/client test",
    "cox:publisher:check": "pnpm --filter @eox/cox-publisher build",
    "cox:publisher:test": "pnpm --filter @eox/cox-publisher test",
    "cox:publisher": "pnpm --filter @eox/cox-publisher start",
    "cox:program:build": "node packages/cox/scripts/deployment.ts build",
    "cox:program:test": "cargo test --manifest-path packages/cox/crates/program-tests/Cargo.toml --locked",
    "cox:deploy": "node packages/cox/scripts/deployment.ts deploy",
    "cox:archiver": "pnpm --filter @eox/ingestion cox:archiver",
    "cox:feed-check": "pnpm --filter @eox/ingestion cox:feed-check",
    "cox:swap:test": "pnpm --filter @cox/client test:swap"
  }
}
