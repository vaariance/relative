[Unit]
Description=Relative native devnet publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cox-publisher
Group=cox-publisher
WorkingDirectory=/opt/cox-publisher/current
ExecStart=/opt/cox-publisher/current/apps/cox-publisher/native/target/release/relative-publisher run --config /etc/cox-publisher/native.json
Restart=on-failure
RestartSec=5
RuntimeDirectory=cox-publisher
StateDirectory=cox-publisher
EnvironmentFile=/etc/cox-publisher/native.env
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cox-publisher /run/cox-publisher
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
