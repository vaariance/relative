[Unit]
Description=Back up Relative native publisher recovery state
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=cox-publisher
Group=cox-publisher
WorkingDirectory=/opt/cox-publisher/current
ExecStart=/opt/cox-publisher/current/apps/cox-publisher/native/target/release/relative-publisher backup --config /etc/cox-publisher/native-backup.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cox-publisher
Nice=10
CPUWeight=20
TimeoutStartSec=900
